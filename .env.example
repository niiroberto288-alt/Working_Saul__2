# Copy this file to .env and fill in the values from your Supabase project.
# Project settings -> API -> Project URL and anon public key.
#
# Leave both empty to run in demo mode during development (`npm run dev`).
# A production build without these values shows the "App not configured" page
# and never exposes demo accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
